QWidget {
  font-family: "Segoe UI", Arial, sans-serif;
  font-size: 13px;
  color: #172033;
  background: #f4f6f8;
}

QTabWidget::pane {
  border: 1px solid #d8dde6;
  background: #ffffff;
}

QPushButton {
  min-height: 36px;
  padding: 6px 14px;
  border: 1px solid #9aa7b8;
  border-radius: 6px;
  background: #ffffff;
}

QPushButton:enabled:hover {
  background: #edf4ff;
  border-color: #4f7fcf;
}

QPushButton:disabled {
  color: #8a95a3;
  background: #eef1f5;
}

QLabel {
  background: transparent;
}

#selectPage {
  background: #eef2f7;
}

#detectPage, #installPage {
  background: #eef2f7;
}

#pageTitleLabel {
  color: #101828;
  font-size: 24px;
  font-weight: 700;
}

#pageSummaryLabel {
  color: #475467;
  font-size: 14px;
}

#sectionTitleLabel {
  color: #344054;
  font-weight: 700;
}

#condaEnvPanel, #installStepsPanel, #installLogPanel, #uninstallPanel {
  border: 1px solid #d8dde6;
  border-radius: 8px;
  background: #ffffff;
}

#condaEnvsLabel {
  min-height: 36px;
  padding: 10px 12px;
  border: 1px solid #dbe3ef;
  border-radius: 6px;
  color: #1d4ed8;
  background: #f8fafc;
}

#selectSidePanel {
  min-width: 250px;
  max-width: 290px;
  border-radius: 8px;
  background: #15324a;
}

#selectSideTitle {
  color: #ffffff;
  font-size: 23px;
  font-weight: 700;
  background: transparent;
}

#selectSideDescription {
  color: #dbeafe;
  font-size: 14px;
  line-height: 1.35;
  background: transparent;
}

#selectSideSteps {
  padding: 16px 0;
  color: #f8fafc;
  font-size: 14px;
  line-height: 1.7;
  background: transparent;
}

#selectSideTip {
  padding: 8px 10px;
  border: 1px solid #93c5fd;
  border-radius: 6px;
  color: #eff6ff;
  background: rgba(147, 197, 253, 0.16);
}

#selectPanelTitle {
  color: #101828;
  font-size: 20px;
  font-weight: 700;
  background: transparent;
}

#selectTitleLabel {
  font-size: 24px;
  font-weight: 700;
  color: #101828;
}

#selectSummaryLabel {
  color: #475467;
  font-size: 14px;
  background: transparent;
}

#environmentHintLabel {
  padding: 10px 12px;
  border: 1px solid #c7d7fe;
  border-radius: 6px;
  background: #eef4ff;
  color: #1d4ed8;
}

#installConfigPanel {
  border: 1px solid #d8dde6;
  border-radius: 8px;
  background: #ffffff;
}

#pathWarningLabel {
  min-height: 28px;
  padding: 8px 10px;
  border: 1px solid #fed7aa;
  border-radius: 6px;
  color: #9a3412;
  background: #fff7ed;
  border-color: #fed7aa;
}

#startInstallButton {
  min-height: 40px;
  padding: 8px 18px;
  border-color: #2563eb;
  background: #2563eb;
  color: #ffffff;
  font-weight: 700;
}

#startInstallButton:enabled:hover {
  border-color: #1d4ed8;
  background: #1d4ed8;
}

#browseWorkspaceButton {
  min-width: 82px;
}

#weightStatusLine {
  color: #475467;
  background: #f8fafc;
}

#statusCard {
  border: 1px solid #d8dde6;
  border-radius: 8px;
  background: #ffffff;
}

#statusCardTitle {
  color: #667085;
  font-weight: 600;
}

#statusCardValue {
  font-size: 19px;
  font-weight: 700;
}

#statusCardDetail {
  color: #475467;
}

QLineEdit, QComboBox, QPlainTextEdit {
  border: 1px solid #c7ced9;
  border-radius: 6px;
  padding: 6px;
  background: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus {
  border-color: #2563eb;
}

#detectButton, #detectNextButton, #cancelInstallButton, #tryPreviewButton, #uninstallEnvButton {
  min-width: 120px;
}

#detectButton, #tryPreviewButton {
  border-color: #2563eb;
  background: #2563eb;
  color: #ffffff;
  font-weight: 700;
}

#detectButton:enabled:hover, #tryPreviewButton:enabled:hover {
  border-color: #1d4ed8;
  background: #1d4ed8;
}

#cancelInstallButton {
  border-color: #d0d5dd;
  background: #ffffff;
}

#uninstallEnvButton {
  border-color: #dc2626;
  background: #fff1f2;
  color: #b91c1c;
  font-weight: 700;
}

#uninstallEnvButton:enabled:hover {
  border-color: #b91c1c;
  background: #ffe4e6;
}

#installLogView {
  min-height: 230px;
  font-family: Consolas, "Microsoft YaHei UI", monospace;
  background: #0f172a;
  color: #e5e7eb;
  border-color: #111827;
}

QLabel[stepStatus="pending"] {
  padding: 10px 12px;
  border: 1px solid #dbe3ef;
  border-radius: 6px;
  color: #475467;
  background: #f8fafc;
}

QLabel[stepStatus="running"] {
  padding: 10px 12px;
  border: 1px solid #bfdbfe;
  border-radius: 6px;
  color: #1d4ed8;
  background: #eff6ff;
}

QLabel[stepStatus="ok"] {
  padding: 10px 12px;
  border: 1px solid #bbf7d0;
  border-radius: 6px;
  color: #166534;
  background: #f0fdf4;
}

QLabel[stepStatus="fail"] {
  padding: 10px 12px;
  border: 1px solid #fecaca;
  border-radius: 6px;
  color: #b91c1c;
  background: #fef2f2;
}
